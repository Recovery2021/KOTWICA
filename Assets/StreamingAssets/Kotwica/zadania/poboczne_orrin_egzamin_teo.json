              ]
            },
            {
              "tekst": "Lepiej, żebyś to umiał. Siadaj, przerobimy napędy razem.",
              "dalej": "teo_nauka",
              "efekty": [
                { "typ": "RozpocznijZadanie", "id": "side_orrin_egzamin" },
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "orrin_teo" },
                { "typ": "ZglosCel", "cel": "Interakcja", "id": "orrin_szkola_terminal" },
                { "typ": "UstawFlage", "id": "teo_uczciwie" }
              ],
              "test": { "atrybut": "Technika", "trudnosc": 3 }
            },
            { "tekst": "To nie dla mnie.", "dalej": "" }
          ]
        },
        {
          "id": "teo_ok",
          "tekst": "Terminal stoi przy wejściu do szkoły technicznej. Uważaj na ludzi: jak ktoś zobaczy, wezwie ochronę.",
          "wybory": []
        },
        {
          "id": "teo_nauka",
          "tekst": "(godzinę później) ...czyli sprzężenie idzie przed stabilizatorem. Dobra. Chyba rozumiem. Przyjdź po egzaminie, powiem ci, jak poszło.",
          "wybory": []
        },
        {
          "id": "teo_czeka",
          "tekst": "Terminal stoi przy wejściu do szkoły. Pośpiesz się, egzamin jutro.",
          "wybory": []
        },
        {
          "id": "teo_daj",
          "tekst": "Masz je? Pokaż!",
          "wybory": [
            {
              "tekst": "Trzymaj.",
              "dalej": "teo_koniec_oszust",
              "efekty": [
