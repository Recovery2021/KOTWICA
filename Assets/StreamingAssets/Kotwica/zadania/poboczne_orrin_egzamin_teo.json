              ]
            },
            {
              "tekst": "Zatrzymam je. Zdasz, bo umiesz więcej, niż myślisz.",
              "dalej": "teo_koniec_uczciwy",
              "efekty": [
                { "typ": "ZabierzPrzedmiot", "id": "odpowiedzi_egzamin", "wartosc": 1 },
                { "typ": "UstawFlage", "id": "teo_uczciwie" },
                { "typ": "Reputacja", "klasa": "KlasaSrednia", "wartosc": 5 },
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "orrin_teo" }
