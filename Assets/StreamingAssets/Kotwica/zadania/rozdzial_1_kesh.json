          "warunki": [
            { "typ": "MaPrzedmiot", "id": "rejestracja_statku" }
          ]
        },
        {
          "wezel": "brodd_depozyt",
          "warunki": [
            { "typ": "FlagaUstawiona", "id": "statek_skonfiskowany" }
          ]
        },
        { "wezel": "brodd_start" }
      ],
      "wezly": [
        {
          "id": "brodd_start",
          "tekst": "Holownik Wróbel. Stary, ale silniki ma uczciwe. Trzysta kredytów i jest twój. Doki Kesh, ładownia na dwie skrzynie. Na inne pierścienie i tak cię nie wpuszczą bez przepustki: straż portowa zabiera statki od ręki.",
          "wybory": [
            {
              "tekst": "Biorę. (300 kr)",
              "dalej": "brodd_kupiony",
              "warunki": [
                { "typ": "KredytyCoNajmniej", "wartosc": 300 }
              ],
              "efekty": [
                { "typ": "Kredyty", "wartosc": -300 },
                { "typ": "DajPrzedmiot", "id": "rejestracja_statku", "wartosc": 1 }
              ]
            },
            {
              "tekst": "Za te silniki? Dwieście dwadzieścia i nie płaczesz.",
              "dalej": "brodd_kupiony",
              "warunki": [
                { "typ": "KredytyCoNajmniej", "wartosc": 220 }
              ],
              "efekty": [
                { "typ": "Kredyty", "wartosc": -220 },
                { "typ": "DajPrzedmiot", "id": "rejestracja_statku", "wartosc": 1 }
              ],
              "test": { "atrybut": "Perswazja", "trudnosc": 3 }
            },
            {
              "tekst": "Osiemdziesiąt teraz, reszta z kursów.",
              "dalej": "brodd_raty",
              "warunki": [
                { "typ": "KredytyCoNajmniej", "wartosc": 80 }
              ],
              "efekty": [
                { "typ": "Kredyty", "wartosc": -80 },
                { "typ": "DajPrzedmiot", "id": "rejestracja_statku", "wartosc": 1 },
                { "typ": "UstawFlage", "id": "dlug_stocznia" }
              ]
            },
            { "tekst": "Jeszcze nie.", "dalej": "" }
          ]
        },
        {
          "id": "brodd_kupiony",
          "tekst": "Rejestracja, kody startowe. Stoi na lądowisku obok. W kokpicie Spacja odcumowuje, a dok B jest kawałek dalej po obręczy, za końcem ulicy. Wypatruj masztu z pomarańczowym światłem.",
          "wybory": []
        },
        {
          "id": "brodd_raty",
          "tekst": "Dobra. Ale jak nie spłacisz, znajdę cię nawet na Varo. Reszta: dwieście dwadzieścia. Kapitan portu płaci za uczciwe kursy, zacznij od niego.",
          "wybory": []
        },
        {
          "id": "brodd_dlug",
          "tekst": "Reszta za Wróbla: dwieście dwadzieścia. Pamiętam.",
          "wybory": [
            {
              "tekst": "Spłacam. (220 kr)",
              "dalej": "brodd_splacone",
              "warunki": [
                { "typ": "KredytyCoNajmniej", "wartosc": 220 }
              ],
              "efekty": [
                { "typ": "Kredyty", "wartosc": -220 },
                { "typ": "UstawFlage", "id": "dlug_splacony" }
              ]
            },
            { "tekst": "Jeszcze nie mam.", "dalej": "" }
          ]
        },
        {
          "id": "brodd_splacone",
          "tekst": "Uczciwy kurier na Kesh. Kto by pomyślał.",
          "wybory": []
        },
        {
          "id": "brodd_wlasciciel",
          "tekst": "Lata? To dobrze. Wróbel ma więcej lat niż ty, szanuj go.",
          "wybory": []
        },
        {
          "id": "brodd_depozyt",
          "tekst": "Straż portowa przyholowała twojego Wróbla. Depozyt: sto pięćdziesiąt.",
          "wybory": [
            {
              "tekst": "Płacę. (150 kr)",
              "dalej": "brodd_odebrany",
              "warunki": [
                { "typ": "KredytyCoNajmniej", "wartosc": 150 }
              ],
              "efekty": [
                { "typ": "Kredyty", "wartosc": -150 },
                { "typ": "DajPrzedmiot", "id": "rejestracja_statku", "wartosc": 1 }
              ]
            },
            { "tekst": "Później.", "dalej": "" }
          ]
        },
        {
          "id": "brodd_odebrany",
          "tekst": "Tym razem miej przepustkę, zanim gdzieś zadokujesz.",
          "wybory": []
        }
      ]
    },
    {
      "id": "dlg_kapitan",
      "rozmowca": "Kapitan portu Hale",
      "wejscia": [
        {
          "wezel": "kap_raport",
          "warunki": [
            { "typ": "CelAktywny", "cel": "Porozmawiaj", "id": "kesh_kapitan" },
