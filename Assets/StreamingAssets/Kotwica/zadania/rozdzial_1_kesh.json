      "wezly": [
        {
          "id": "mara_start",
          "tekst": "Ty jesteś ten nowy? Podnośnik znowu stanął, a zmiana zaraz się zaczyna. Jak nie ruszy, potrącą mi z dniówki. A córka... córka kaszle od tygodnia.",
          "wybory": [
            {
              "tekst": "Pokaż ten podnośnik.",
              "dalej": "mara_ok",
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "kesh_dokerka_start" }
              ]
            },
            { "tekst": "Co z córką?", "dalej": "mara_corka" }
          ]
        },
        {
          "id": "mara_corka",
          "tekst": "Powietrze w barakach. Medyczka mówi, że lek jest, ale na przydział. A przydziały idą najpierw na górę, na Varo.",
          "wybory": [
            {
              "tekst": "Najpierw podnośnik. Potem zobaczymy.",
              "dalej": "mara_ok",
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "kesh_dokerka_start" }
              ]
            }
          ]
        },
        {
          "id": "mara_ok",
          "tekst": "Stoi za mną. Moduł sterujący się zatarł. Wyjmij go, Bren z warsztatu na ulicy go postawi.",
          "wybory": []
        },
        {
          "id": "mara_podnosnik",
          "tekst": "Moduł siedzi pod osłoną z boku. Odkręcisz cztery śruby i wyjdzie.",
          "wybory": []
        },
        {
          "id": "mara_serwis",
          "tekst": "Warsztat Brena jest w połowie ulicy, między barakami. Nie zgub tego modułu, nie mam na nowy.",
          "wybory": []
        },
        {
          "id": "mara_ambulatorium",
          "tekst": "Ambulatorium jest przed pompownią. Powiedz medyczce, że to dla małej Mary.",
          "wybory": []
        },
        {
          "id": "mara_lek_legalny",
          "tekst": "Ze stemplem? Z przydziału? (ściska opakowanie) Nikt tu nie dostaje przydziału...",
          "wybory": [
            {
              "tekst": "Dla córki.",
              "dalej": "mara_koniec",
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "kesh_dokerka" },
                { "typ": "ZabierzPrzedmiot", "id": "lek_przydzial", "wartosc": 1 },
                { "typ": "Kredyty", "wartosc": 100 },
                { "typ": "Reputacja", "klasa": "Robotnicy", "wartosc": 5 },
                { "typ": "UstawFlage", "id": "ch1_lek" },
                { "typ": "UstawFlage", "id": "ch1_lek_legalny" }
              ]
            }
          ]
        },
        {
          "id": "mara_lek_nielegalny",
          "tekst": "Bez stempla? Jak ochrona to u mnie znajdzie... (chowa pod kurtkę) Nieważne. Dziękuję.",
          "wybory": [
            {
              "tekst": "Nikt się nie dowie.",
              "dalej": "mara_koniec",
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "kesh_dokerka" },
                { "typ": "ZabierzPrzedmiot", "id": "lek_bez_zgody", "wartosc": 1 },
                { "typ": "Kredyty", "wartosc": 100 },
                { "typ": "Reputacja", "klasa": "Robotnicy", "wartosc": 10 },
                { "typ": "Reputacja", "klasa": "Elita", "wartosc": -5 },
                { "typ": "UstawFlage", "id": "ch1_lek" },
                { "typ": "UstawFlage", "id": "ch1_lek_nielegalny" }
              ]
            }
          ]
        },
        {
          "id": "mara_bez_leku",
          "tekst": "Nie dali? ...Jasne. Na Kesh nikt nic nie daje.",
          "wybory": [
            { "tekst": "Wrócę z lekiem.", "dalej": "" },
            {
              "tekst": "Przepraszam. Nie dało się.",
              "dalej": "mara_koniec_bez",
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "kesh_dokerka" },
                { "typ": "Kredyty", "wartosc": 100 },
                { "typ": "Reputacja", "klasa": "Robotnicy", "wartosc": -5 },
                { "typ": "UstawFlage", "id": "ch1_bez_leku" }
              ]
            }
          ]
        },
        {
          "id": "mara_koniec",
          "tekst": "Za podnośnik i za to... sto kredytów. Więcej nie mam. Słuchaj: Brodd na pokładzie sprzedaje stary holownik. Ze statkiem zarobisz więcej niż na nogach. A kapitan portu na doku B szuka ludzi, którym można ufać.",
          "wybory": []
        },
        {
          "id": "mara_koniec_bez",
          "tekst": "Sto kredytów za podnośnik. Tyle mogę. Słuchaj: Brodd na pokładzie sprzedaje stary holownik. Ze statkiem zarobisz więcej niż na nogach. A kapitan portu na doku B szuka ludzi, którym można ufać.",
          "wybory": []
        },
        {
          "id": "mara_po",
          "tekst": "Córka śpi spokojnie, pierwszy raz od tygodnia.",
          "wybory": []
        },
        {
          "id": "mara_po_bez",
          "tekst": "Córka dalej kaszle. Jakoś to będzie. Zawsze jakoś było.",
          "wybory": []
        },
        {
          "id": "mara_idle",
          "tekst": "Zmiana się zaczyna. Nie mam czasu.",
          "wybory": []
        }
      ]
    },
    {
      "id": "dlg_medyczka",
      "rozmowca": "Medyczka Nadia",
      "wejscia": [
        {
          "wezel": "med_start",
          "warunki": [
            { "typ": "CelAktywny", "cel": "Porozmawiaj", "id": "kesh_medyczka" }
          ]
        },
        {
          "wezel": "med_start",
          "warunki": [
            { "typ": "CelAktywny", "cel": "Porozmawiaj", "id": "kesh_dokerka" },
            { "typ": "NieMaPrzedmiotu", "id": "lek_przydzial" },
            { "typ": "NieMaPrzedmiotu", "id": "lek_bez_zgody" }
          ]
        },
        { "wezel": "med_idle" }
      ],
      "wezly": [
        {
          "id": "med_start",
          "tekst": "Lek dla córki dokerki? Jest. Na półce za mną, w skrzynce z plombą Zarządu. Przydział dla Kesh na ten cykl już wydany. Reszta leci na Varo.",
          "wybory": [
            {
              "tekst": "Złożę wniosek o przydział. (opłata 60 kr)",
              "dalej": "med_przydzial",
              "warunki": [
                { "typ": "KredytyCoNajmniej", "wartosc": 60 }
              ],
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "kesh_medyczka" },
                { "typ": "Kredyty", "wartosc": -60 },
                { "typ": "DajPrzedmiot", "id": "lek_przydzial", "wartosc": 1 }
              ]
            },
            {
              "tekst": "Dziecko kaszle od tygodnia. Pani wie, że to nie może czekać do następnego cyklu.",
              "dalej": "med_perswazja",
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "kesh_medyczka" },
                { "typ": "DajPrzedmiot", "id": "lek_przydzial", "wartosc": 1 }
              ],
              "test": { "atrybut": "Perswazja", "trudnosc": 3 }
            },
            {
              "tekst": "A gdyby jedna skrzynka zginęła w drodze na Varo?",
              "dalej": "med_bez_zgody",
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "kesh_medyczka" },
                { "typ": "DajPrzedmiot", "id": "lek_bez_zgody", "wartosc": 1 }
              ]
            },
            {
              "tekst": "Nie stać mnie. Powiem Marze.",
              "dalej": "",
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "kesh_medyczka" }
              ]
            },
            { "tekst": "Wrócę później.", "dalej": "" }
          ]
        },
        {
          "id": "med_przydzial",
          "tekst": "(stempluje formularz) Przydział z rezerwy. Oficjalnie. Niech pan to trzyma przy sobie, ochrona sprawdza.",
          "wybory": []
        },
        {
          "id": "med_perswazja",
          "tekst": "(długo milczy) ...Wypiszę z rezerwy awaryjnej. Za darmo. I nie było tej rozmowy.",
          "wybory": []
        },
        {
          "id": "med_bez_zgody",
          "tekst": "Nic nie słyszałam. Skrzynka stoi przy drzwiach, a ja idę na zaplecze.\n\n(Lek bez przydziału: jeśli ochrona go znajdzie, przepadnie.)",
          "wybory": []
        },
        {
          "id": "med_idle",
          "tekst": "Ambulatorium Kesh. Jeśli nie krwawisz, czekaj w kolejce.",
          "wybory": []
        }
      ]
    },
    {
