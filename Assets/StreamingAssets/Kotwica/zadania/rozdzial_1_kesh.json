          ]
        },
        {
          "wezel": "kap_start",
          "warunki": [
            { "typ": "CelAktywny", "cel": "Porozmawiaj", "id": "kesh_kapitan" }
          ]
        },
        {
          "wezel": "kap_szukaj",
          "warunki": [
            { "typ": "CelAktywny", "cel": "Interakcja", "id": "kesh_b_kontener" }
          ]
        },
        {
          "wezel": "kap_po",
          "warunki": [
            { "typ": "MaPrzedmiot", "id": "przepustka_orrin" }
          ]
        },
        { "wezel": "kap_idle" }
      ],
      "wezly": [
        {
          "id": "kap_start",
          "tekst": "Mara mówi, że można ci ufać. Sprawdzimy. Ktoś podmienia plomby na kontenerach z filtrami powietrza: dobre filtry lecą na Orrin, a do baraków trafia złom. Znajdź podmieniony kontener i przynieś mi plombę.",
          "wybory": [
            {
              "tekst": "Załatwione.",
              "dalej": "kap_ok",
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "kesh_kapitan" }
              ]
            },
            { "tekst": "Co z tego będę miał?", "dalej": "kap_nagroda" }
          ]
        },
        {
          "id": "kap_nagroda",
          "tekst": "Przepustkę na Orrin. Prawdziwą, z moim podpisem. Bez niej straż portowa na Orrin zabierze ci statek, zanim wyłączysz silniki.",
          "wybory": [
            {
              "tekst": "Biorę to.",
              "dalej": "kap_ok",
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "kesh_kapitan" }
              ]
            }
          ]
        },
        {
          "id": "kap_ok",
          "tekst": "Trzy kontenery przy rampie. Sprawdź plomby. Numery Zarządu mają kreskę pod ostatnią cyfrą.",
          "wybory": []
        },
        {
          "id": "kap_szukaj",
          "tekst": "Trzy kontenery przy rampie. Któraś plomba jest podrobiona.",
          "wybory": []
        },
        {
          "id": "kap_raport",
          "tekst": "(ogląda plombę pod lampą) Podróbka. Dobra robota. Trzymaj: przepustka na Orrin i transport filtrów. Zawieź je do portu Orrin i patrz, komu tam zależy na przydziałach.",
          "wybory": [
            {
              "tekst": "Lecę.",
              "dalej": "kap_koniec",
              "efekty": [
                { "typ": "ZabierzPrzedmiot", "id": "podmieniona_plomba", "wartosc": 1 },
                { "typ": "DajPrzedmiot", "id": "przepustka_orrin", "wartosc": 1 },
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "kesh_kapitan" }
              ]
            },
            {
              "tekst": "Za taką robotę należy się coś więcej.",
              "dalej": "kap_premia",
