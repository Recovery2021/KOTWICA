        {
          "id": "sel_start",
          "tekst": "Numerek? Przydziały na Varo wyczerpane do końca cyklu. Następny!",
          "wybory": [
            { "tekst": "Wyczerpane? Na targu mówią, że da się je kupić.", "dalej": "sel_rynek" },
