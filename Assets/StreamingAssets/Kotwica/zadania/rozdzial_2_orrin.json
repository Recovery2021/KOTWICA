            { "tekst": "Nieważne.", "dalej": "" }
          ]
        },
        {
          "id": "sel_rynek",
          "tekst": "(ścisza głos) Proszę tego nie mówić przy kolejce. Ja tylko stempluję. Rejestr nie zgadza się od miesięcy, ale archiwum to nie moja sprawa. Terminal B-12, zaraz za mną. Bez kodu nic pan nie zobaczy.",
          "wybory": [
            {
              "tekst": "To niech mi pani da kod. Nikt się nie dowie, że to od pani.",
              "dalej": "sel_prawda",
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "orrin_urzednik" },
                { "typ": "DajPrzedmiot", "id": "kod_archiwum", "wartosc": 1 },
                { "typ": "UstawFlage", "id": "sel_ufa" }
              ],
              "test": { "atrybut": "Perswazja", "trudnosc": 3 }
            },
            {
              "tekst": "Poradzę sobie bez kodu.",
              "dalej": "",
              "efekty": [
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "orrin_urzednik" }
              ]
            }
          ]
        },
        {
          "id": "sel_prawda",
          "tekst": "...Dobrze. Cztery, cztery, zero, B. Jeśli ktoś zapyta, stał pan w kolejce jak wszyscy. I niech pan uważa na Dorna z targu. Zawsze ma towar, którego nikt inny nie ma.",
          "wybory": [
            { "tekst": "Dziękuję.", "dalej": "" }
          ]
        },
        {
          "id": "sel_lapowka",
          "tekst": "(chowa kredyty pod formularze) Kod do archiwum leży na biurku. Gdyby pan go przypadkiem zobaczył... Następny!",
          "wybory": [
            { "tekst": "Rozumiem.", "dalej": "" }
          ]
        },
        {
          "id": "sel_archiwum",
          "tekst": "Terminal B-12 jest za mną. Ja niczego nie widzę. Następny!",
          "wybory": []
        },
        {
          "id": "sel_raport",
          "tekst": "Wyciąg z rejestru? Z kluczem Dorna... (długo milczy) Złożę raport. A pan dostanie przydział. Prawdziwy, z moim podpisem.",
          "wybory": [
            {
              "tekst": "Oddaj wyciąg.",
              "dalej": "sel_raport_koniec",
              "efekty": [
                { "typ": "ZabierzPrzedmiot", "id": "wyciag_rejestru", "wartosc": 1 },
                { "typ": "DajPrzedmiot", "id": "przepustka_varo", "wartosc": 1 },
                { "typ": "UstawFlage", "id": "ch2_sel_oficjalna" },
                { "typ": "Reputacja", "klasa": "KlasaSrednia", "wartosc": 5 }
              ]
            }
          ]
        },
        {
          "id": "sel_raport_koniec",
          "tekst": "Port Varo przyjmie pana statek. I proszę... niech pan tu nie wraca przez jakiś czas.",
          "wybory": []
        },
        {
          "id": "sel_po",
          "tekst": "Raport poszedł do Zarządu. Mam nadzieję, że trafi do właściwych rąk.",
          "wybory": []
        },
