                { "typ": "UstawFlage", "id": "ida_doniesiona" },
                { "typ": "Reputacja", "klasa": "Elita", "wartosc": 10 },
                { "typ": "Kredyty", "wartosc": 50 }
              ]
            },
            { "tekst": "Nie interesuje mnie to.", "dalej": "" }
          ]
        },
        {
          "id": "ida_ile",
          "tekst": "Sto pięćdziesiąt na rękę od pasera. Elita nie zapomina, ale elita nie schodzi na Kesh.",
          "wybory": [
            {
              "tekst": "Wchodzę w to.",
              "dalej": "ida_ok",
              "efekty": [
                { "typ": "RozpocznijZadanie", "id": "side_varo_probki" },
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "varo_laborantka" }
              ]
            },
            { "tekst": "Nie.", "dalej": "" }
          ]
        },
        {
          "id": "ida_co",
          "tekst": "Wyniki badań powietrza z dolnych pierścieni. Prawdziwe wyniki. Ludzie na Kesh oddychają czymś, czego nie ma w raportach.",
          "wybory": [
            {
              "tekst": "Wchodzę w to.",
              "dalej": "ida_ok",
              "efekty": [
                { "typ": "RozpocznijZadanie", "id": "side_varo_probki" },
                { "typ": "ZglosCel", "cel": "Porozmawiaj", "id": "varo_laborantka" }
              ]
            },
            { "tekst": "Nie.", "dalej": "" }
          ]
        },
        {
          "id": "ida_ok",
          "tekst": "Chłodnia stoi przy laboratorium. Kamery patrzą na ulicę, nie na chłodnię. Zwykle.",
          "wybory": []
        },
        {
          "id": "ida_donos",
          "tekst": "(blednie) Nie... Proszę... (za tobą słychać kroki ochrony)",
          "wybory": []
        },
        {
          "id": "ida_czeka",
          "tekst": "Proszę się pośpieszyć. Zmiana ochrony za pół godziny.",
          "wybory": []
        },
        {
          "id": "ida_paser",
          "tekst": "Ma je pan? To na Kesh, do pasera. I proszę tu nie wracać przez jakiś czas.",
