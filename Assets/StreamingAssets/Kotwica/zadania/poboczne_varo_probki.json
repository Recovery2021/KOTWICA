            { "tekst": "Ile?", "dalej": "ida_ile" },
            { "tekst": "Co jest w tych próbkach?", "dalej": "ida_co" },
            {
              "tekst": "Zgłoszę to ochronie.",
              "dalej": "ida_donos",
